# 复制为 .env 并填入真实值；.env 不进仓库
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TRANSLATE_MODEL=deepseek-v4-pro
STUCK_CONF_HIGH=0.7
STUCK_CONF_LOW=0.4

# 携程营销 MCP（真实数据：航班、酒店、门票、租车、火车），见 docs/mcp/01-携程MCP接入说明.md
TRIP_MCP_TOKEN=
# LC_LIVE=off                # 关闭真实数据，全部用 mock/*.json
# LC_LIVE_TTL=1800           # 缓存秒数
# LC_DEMO_SHIFT=auto         # 演示行程过期时整周后移；0 关闭
